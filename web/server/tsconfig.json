  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "../dist-server", "rootDir": ".", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "noEmit": false
  },
  "include": ["./**/*.ts"],
  "exclude": ["../dist-server", "./**/*.test.ts"]
}
