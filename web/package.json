{
  "name": "dagboek-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "tsc -p server/tsconfig.json && node -e \"require('node:fs').cpSync('server/migrations','dist-server/migrations',{recursive:true})\" && vite build --config client/vite.config.ts",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test:pg": "bash scripts/test-pg.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
