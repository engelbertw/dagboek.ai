# Postgres (op Railway: verwijs naar de database-service). 'memory' draait op een tijdelijke database, alleen om lokaal te proberen.
DATABASE_URL=
# Lange willekeurige waarde waarmee sessiecookies worden ondertekend
SESSION_SECRET=
# Inloggegevens van de beheerder; maak de hash met: npx tsx server/hash.ts 'jouw-wachtwoord-van-12-tekens'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Sleutel waarmee de voice-service uitkomsten mag melden (zelfde waarde als WEB_SERVICE_KEY bij voice)
SERVICE_KEY=
# De voice-service, voor 'Bel nu' (VOICE_ADMIN_TOKEN is de ADMIN_TOKEN van voice)
VOICE_URL=
VOICE_ADMIN_TOKEN=
PORT=3000
# Alleen lokaal zonder https:
# INSECURE_COOKIES=true
# Taalmodel voor de samenvatting na een gesprek (OpenAI-compatibel; dezelfde gateway als de voice-service)
TSYSTEMS_BASE_URL=
TSYSTEMS_API_KEY=
LLM_MODEL=gemma-4
