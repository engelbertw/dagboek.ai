# Taalmodel en spraak-naar-tekst via de T-Systems-gateway (OpenAI-compatibel)
TSYSTEMS_BASE_URL=
TSYSTEMS_API_KEY=
LLM_MODEL=gemma-4
STT_MODEL=whisper-large-v3-turbo

# ElevenLabs: de stem van Engelbert is de standaard (enmqCP0KND7ESmQRStwc)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=enmqCP0KND7ESmQRStwc

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Publieke hostnaam waarop Twilio deze service bereikt (zonder https://), bijvoorbeeld het ngrok- of Railway-domein
PUBLIC_HOST=
# Gedeeld geheim voor de websocket; genereer een lange willekeurige waarde
WS_TOKEN=

# Beveiliging van /bel (alleen voor handmatige tests in fase 0)
ADMIN_TOKEN=

# Waar opdrachten en transcripten staan (op Railway: een volume)
DATA_DIR=./data
OPDRACHTGEVER_NAAM=Engelbert

# Limieten voor uitgaand bellen
UITGAAND_MAX_PER_UUR=20
UITGAAND_MIN_SECS_PER_NUMMER=300
BEL_TIMEOUT_SECS=30
